<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="68dp" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:paddingVertical="6dp"
    android:background="?attr/selectableItemBackgroundBorderless">
    <ImageView android:id="@+id/icon" android:layout_width="26dp" android:layout_height="26dp" />
    <TextView android:id="@+id/label"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textSize="10.5sp" android:maxLines="2"
        android:gravity="center" />
</LinearLayout>
